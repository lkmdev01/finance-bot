# ======================================
# Laravel (web / worker / scheduler)
# ======================================
APP_NAME=Financi
APP_ENV=production
APP_KEY=base64:COLE_SUA_APP_KEY
APP_DEBUG=false
APP_URL=https://SEU_DOMINIO
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=SEU_DB_HOST
DB_PORT=3306
DB_DATABASE=SEU_DB_DATABASE
DB_USERNAME=SEU_DB_USERNAME
DB_PASSWORD=SEU_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# WhatsApp bridge (Laravel -> whatsapp-service)
BAILEYS_SERVICE_URL=http://financi-whatsapp:3001
BAILEYS_WEBHOOK_SECRET=TROQUE_POR_SECRET_FORTE

# AI provider
AI_PROVIDER=groq
AI_API_KEY=COLE_SUA_CHAVE_IA
GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2

# Mail (ajuste se usar SMTP real)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@SEU_DOMINIO
MAIL_FROM_NAME="${APP_NAME}"

# Opcional (S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ======================================
# whatsapp-service (Node)
# ======================================
# Use estas variáveis no serviço Node separado.
WHATSAPP_SERVICE_PORT=3001
LARAVEL_URL=https://SEU_DOMINIO
WEBHOOK_SECRET=TROQUE_POR_SECRET_FORTE

# IMPORTANTE:
# 1) WEBHOOK_SECRET deve ser igual a BAILEYS_WEBHOOK_SECRET do Laravel.
# 2) Configure volume persistente para a pasta auth_info/ no serviço whatsapp.
